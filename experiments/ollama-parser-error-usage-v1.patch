+package server
+
+import (
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/ollama/ollama/api"
+)
+
+// Versioned local extension: a rejected tool call remains an error, but the
+// terminal inference's measurements are not discarded by argument parsing.
+// Nonterminal errors have no final count; in particular, do not invent zero.
+func chatParserError(err error, response api.ChatResponse) gin.H {
+	result := gin.H{"error": err.Error()}
+	if !response.Done || response.EvalCount < 0 || response.PromptEvalCount < 0 ||
+		!strings.HasPrefix(err.Error(), "error parsing tool call:") {
+		return result
+	}
+	result["playtime_error_usage"] = 1
+	result["model"] = response.Model
+	result["done"] = true
+	result["done_reason"] = response.DoneReason
+	result["eval_count"] = response.EvalCount
+	result["prompt_eval_count"] = response.PromptEvalCount
+	result["total_duration"] = response.TotalDuration
+	result["load_duration"] = response.LoadDuration
+	result["prompt_eval_duration"] = response.PromptEvalDuration
+	result["eval_duration"] = response.EvalDuration
+	return result
+}
